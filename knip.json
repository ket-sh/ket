{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["mise"],
  "workspaces": {
    ".": {
      "entry": [
        ".claude/workflows/**/*.{mts,mjs}",
        "probity.config.ts",
        "commitlint.config.ts",
        "steiger.config.ts"
      ],
      "project": [
        ".claude/workflows/**/*.{mts,mjs}",
        "probity.config.ts",
        "commitlint.config.ts",
        "steiger.config.ts"
      ]
    },
    "packages/cli": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": ["@steiger/toolkit"]
}
