{
  "extends": "@ket/tsconfig/base.json",
  "compilerOptions": {
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "vitest.git-setup.ts",
    "vitest.projects.ts",
    "vitest.toolbox-global.ts",
    "vitest.toolbox-setup.ts"
  ],
  "exclude": ["src/commands/item/surface/client/**/*.ts"]
}
