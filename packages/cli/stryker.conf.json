{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-core.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner", "@stryker-mutator/typescript-checker"],
  "vitest": {
    "configFile": "vitest.mutation.config.ts"
  },
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/commands/item/surface/styles.generated.ts",
    "!src/main.ts",
    "!src/run.ts",
    "!src/commands/*/command.ts",
    "!src/shared/write-files.ts",
    "!src/commands/*/wizard.ts",
    "!src/shared/git.ts",
    "!src/shared/checks.ts",
    "!src/commands/*/announce.ts",
    "!src/commands/gate/command.ts",
    "!src/commands/gate/turn.ts",
    "!src/shared/event-log.ts",
    "!src/commands/*/context.ts",
    "!src/commands/gate/test-first.ts",
    "!src/commands/item/command.ts",
    "!src/commands/gate/shell.ts",
    "!src/commands/create/skills-install.ts",
    "!src/commands/gate/toolchain.ts",
    "!src/shared/governing.ts"
  ],
  "reporters": ["progress", "clear-text"],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "tsconfigFile": "tsconfig.stryker.json",
  "disableTypeChecks": false,
  "checkers": ["typescript"],
  "tempDirName": "../../.stryker-tmp/cli"
}
