{
  "name": "@ket/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/run.ts"
  },
  "scripts": {
    "build": "bun build src/run.ts --compile --outfile dist/ket",
    "test": "vitest run",
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "fmt": "oxfmt --config ../../.oxfmtrc.json .",
    "fmt:check": "oxfmt --config ../../.oxfmtrc.json --check .",
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.surface.json",
    "test:mutation": "stryker run",
    "generate": "bun scripts/generate-pipeline-commands.ts && oxfmt --config ../../.oxfmtrc.json src/commands/create/pipeline-commands.generated.ts"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@ket/preset": "workspace:*",
    "@ket/preset-cli": "workspace:*",
    "@ket/preset-web": "workspace:*",
    "@ket/tui": "workspace:*",
    "citty": "0.2.2",
    "cli-table3": "0.6.5",
    "diff2html": "^3.4.56",
    "gridstack": "^13.0.2",
    "marked": "^17",
    "picocolors": "1.1.1",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
