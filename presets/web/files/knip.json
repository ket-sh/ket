{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["mise"],
  "ignoreDependencies": [
    "@steiger/toolkit",
    "tailwindcss",
    "@fontsource-variable/google-sans-flex",
    "@fontsource-variable/google-sans-code"
  ],
  "entry": [
    "src/app/router.tsx",
    "src/app/routes/**/*.tsx",
    "vitest.mutation.config.ts",
    "steiger.config.ts",
    "probity.config.ts",
    "e2e/**/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "*.config.ts"],
  "ignore": ["**/*.gen.ts", "env.d.ts", "src/shared/ui/**"]
}
