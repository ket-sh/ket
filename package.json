{
  "name": "ket",
  "private": true,
  "workspaces": [
    "packages/*",
    "presets/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types && bun run check-types:workflows",
    "check-types:workflows": "tsc -p .claude/workflows/tsconfig.json",
    "lint:prose": "mise exec -- vale .",
    "lint:spell": "cspell --no-progress \"**\"",
    "gate": "turbo run gate"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.3.14",
    "cspell": "^10.0.1",
    "jscpd": "^5.0.14",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": []
}
