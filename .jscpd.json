{
  "format": ["typescript"],
  "formatsExts": {
    "typescript": ["ts", "tsx", "mts"]
  },
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/*.gen.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/presets/*/files/**"
  ],
  "minTokens": 50,
  "minLines": 5,
  "threshold": 0,
  "reporters": ["console"]
}
