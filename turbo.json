{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "fmt": {
      "cache": false
    },
    "fmt:check": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "gate": {
      "dependsOn": ["lint", "fmt:check", "check-types", "test"]
    }
  }
}
